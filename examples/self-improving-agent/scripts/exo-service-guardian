#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
EXO_ROOT="${EXO_ROOT:-$ROOT_DIR/.exo}"
STATE_DIR="$EXO_ROOT"
CONFIG_FILE="${EXO_SERVICE_GUARDIAN_CONFIG:-$STATE_DIR/exo-service-guardian.env}"

# Match exo.sh: services restarted by the guardian spawn node (harness runner,
# managed adapter turns), so put the mise-pinned toolchain on PATH. Without this, a
# guardian restart inherits whatever ambient node is around (e.g. an old nvm
# node) and harness turns can crash on missing Web API globals.
if [[ -x "$HOME/.local/bin/mise" ]] || command -v mise >/dev/null 2>&1; then
  export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
fi
if [[ -f "$HOME/.cargo/env" ]]; then
  # shellcheck disable=SC1091
  . "$HOME/.cargo/env"
fi

HARNESS="exo"
EXO_BIN="${EXO_BIN:-$ROOT_DIR/target/debug/exo}"
SCHEDULER_BIN="${EXO_SCHEDULER_BIN:-$ROOT_DIR/target/debug/exo-scheduler-runner}"
ENV_FILE="${EXO_ENV_FILE:-$ROOT_DIR/.env}"
SCHEDULER_INTERVAL_SECONDS="${EXO_SCHEDULER_INTERVAL_SECONDS:-10}"

for arg_index in "$@"; do
  if [[ "${previous_arg:-}" == "--config" ]]; then
    CONFIG_FILE="$arg_index"
    break
  fi
  previous_arg="$arg_index"
done

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

# Activation preflight profile (fail-closed), read *after* the config file is
# sourced so .exo/exo-service-guardian.env is an authoritative place to set it.
# The value selects a hardcoded command list below; the gate never executes
# free-form shell strings taken from the environment.
PREFLIGHT_PROFILE="${EXO_ACTIVATION_PREFLIGHT_PROFILE:-default}"
case "$PREFLIGHT_PROFILE" in
  default | full | off) ;;
  *)
    echo "error: unknown EXO_ACTIVATION_PREFLIGHT_PROFILE '$PREFLIGHT_PROFILE' (expected default, full, or off)" >&2
    exit 1
    ;;
esac

usage() {
  cat <<'EOF'
Usage:
  examples/self-improving-agent/scripts/exo-service-guardian <command> [options]

Commands:
  status                    Show guardian-managed service status and logs
  configure [options]       Save launch settings in .exo/exo-service-guardian.env
  build                     Build exo and the Exo scheduler runner, then ask
                            the control REPL wrapper to refresh its child
  start-services            Start scheduler and adapter runners
  stop-services             Stop scheduler and adapter runners, preserving .exo state
  restart-services          Restart scheduler and adapter runners
  restart-adapters          Restart only the adapter runner
  restart-scheduler         Restart only the scheduler runner
  restart-all [--build]     Optionally build, then restart scheduler and adapters
  logs [scheduler|adapters] Print recent service logs

Options:
  --env-file <path>         Env file to read if present (default: .env)
  --exo-bin <path>          exo binary path (default: ./target/debug/exo)
  --scheduler-bin <path>    Scheduler runner path
  --scheduler-interval <n>  Scheduler polling interval seconds (default: 10)
  --config <path>           Service guardian config path (default: .exo/exo-service-guardian.env)
  --build                   For restart-all, build before restarting services
  --help                    Show this help

Activation is fail-closed: before a freshly built candidate is activated
(restart-all --build), required preflight checks must pass. The check set is
selected by EXO_ACTIVATION_PREFLIGHT_PROFILE, which may be set in
.exo/exo-service-guardian.env: "default" (lint, typecheck, cargo check -p exo,
harness import smoke), "full" (default plus pnpm test and a workspace cargo
check), or "off" (binary smoke checks only; not recommended). The candidate
binaries are always smoke-checked (executable, --help exits 0). Each check's
result is recorded in .exo/activation-preflight.json; the first failure stops
the restart with exit code 3 (preflight_failed) and the currently running
version remains active. A plain restart-all without --build does not run the
preflight: it restarts the already-active version, not a new candidate.

The service guardian owns host-side services only. It never deletes .exo state, adapter
pairing data, conversations, artifacts, or sandbox records.
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

quote_var() {
  local name="$1"
  local value="$2"
  printf '%s=' "$name"
  printf '%q\n' "$value"
}

write_config() {
  ensure_state_dir
  {
    echo "# Exo guardian host-side launch settings."
    echo "# This file is local state and should not be committed."
    quote_var "EXO_BIN" "$EXO_BIN"
    quote_var "SCHEDULER_BIN" "$SCHEDULER_BIN"
    quote_var "ENV_FILE" "$ENV_FILE"
    quote_var "SCHEDULER_INTERVAL_SECONDS" "$SCHEDULER_INTERVAL_SECONDS"
  } >"$CONFIG_FILE"
  echo "Wrote service guardian config: $CONFIG_FILE"
}

run_cargo() {
  if command -v mise >/dev/null 2>&1; then
    (cd "$ROOT_DIR" && CARGO_TARGET_DIR=target mise exec -- cargo "$@")
  else
    (cd "$ROOT_DIR" && CARGO_TARGET_DIR=target cargo "$@")
  fi
}

build_all() {
  echo "Building exo..."
  run_cargo build -p exo --ignore-rust-version
  echo "Building Exo scheduler runner..."
  run_cargo build --manifest-path examples/self-improving-agent/scheduler-runner/Cargo.toml --ignore-rust-version
  validate_activation
  request_repl_restart
}

# Fail-closed activation boundary: the currently running version stays active
# until every required preflight check on the candidate succeeds. A successful
# build alone does not prove the candidate is safe to activate, so run the
# profile's required checks before anything is restarted. Each check's result
# (name, exit code, duration) is recorded in
# $STATE_DIR/activation-preflight.json so a rejected candidate is an
# inspectable iteration, and a preflight failure exits with code 3 so the
# deferred runner can record the distinct "preflight_failed" terminal state;
# services are untouched either way.
PREFLIGHT_REPORT="$STATE_DIR/activation-preflight.json"
PREFLIGHT_EXIT_PREFLIGHT_FAILED=3

validate_activation() {
  echo "Validating candidate before activation (fail-closed, profile: $PREFLIGHT_PROFILE)..."
  PREFLIGHT_ENTRIES=""
  preflight_check "candidate-exo-smoke" "candidate exo binary executable + --help" \
    candidate_smoke_check_exo
  preflight_check "candidate-scheduler-smoke" "candidate scheduler binary executable + --help" \
    candidate_smoke_check_scheduler
  case "$PREFLIGHT_PROFILE" in
    default)
      preflight_check "pnpm-lint" "pnpm lint" preflight_pnpm_lint
      preflight_check "pnpm-typecheck" "pnpm typecheck" preflight_pnpm_typecheck
      preflight_check "cargo-check-exo" "cargo check -p exo" preflight_cargo_check_exo
      preflight_check "harness-import-smoke" "harness import smoke" preflight_harness_import_smoke
      ;;
    full)
      preflight_check "pnpm-lint" "pnpm lint" preflight_pnpm_lint
      preflight_check "pnpm-typecheck" "pnpm typecheck" preflight_pnpm_typecheck
      preflight_check "pnpm-test" "pnpm test" preflight_pnpm_test
      preflight_check "cargo-check-workspace" "cargo check --workspace" preflight_cargo_check_workspace
      preflight_check "harness-import-smoke" "harness import smoke" preflight_harness_import_smoke
      ;;
    off)
      echo "  EXO_ACTIVATION_PREFLIGHT_PROFILE=off: only the candidate binary smoke checks ran."
      ;;
  esac
  preflight_write_report "passed" 0
  echo "Activation preflight passed."
}

# Run one required check, record its result, and fail closed (exit 3) on the
# first failure so the deferred runner records a preflight_failed outcome.
preflight_check() {
  local name="$1"
  local description="$2"
  local fn="$3"
  echo "  preflight [$name]: $description"
  local started seconds code
  started=$SECONDS
  set +e
  "$fn"
  code=$?
  set -e
  seconds=$((SECONDS - started))
  if [[ -n "$PREFLIGHT_ENTRIES" ]]; then
    PREFLIGHT_ENTRIES+=","$'\n  '
  fi
  if [ "$code" -eq 0 ]; then
    PREFLIGHT_ENTRIES+="{\"name\": \"$name\", \"status\": \"passed\", \"exitCode\": $code, \"durationMs\": $((seconds * 1000))}"
  else
    PREFLIGHT_ENTRIES+="{\"name\": \"$name\", \"status\": \"failed\", \"exitCode\": $code, \"durationMs\": $((seconds * 1000))}"
  fi
  if [ "$code" -ne 0 ]; then
    preflight_write_report "preflight_failed" "$code"
    echo "error: activation preflight [$name] failed (exit $code); refusing to activate the candidate; the currently running version remains active; per-check results: $PREFLIGHT_REPORT" >&2
    exit "$PREFLIGHT_EXIT_PREFLIGHT_FAILED"
  fi
}

preflight_write_report() {
  local overall="$1"
  local exit_code="$2"
  ensure_state_dir
  {
    printf '{\n'
    printf '  "generatedAt": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '  "profile": "%s",\n' "$PREFLIGHT_PROFILE"
    printf '  "status": "%s",\n' "$overall"
    printf '  "exitCode": %s,\n' "$exit_code"
    printf '  "checks": [\n'
    printf '%s' "$PREFLIGHT_ENTRIES" | sed 's/^/    /'
    printf '  ]\n'
    printf '}\n'
  } > "$PREFLIGHT_REPORT.tmp"
  mv "$PREFLIGHT_REPORT.tmp" "$PREFLIGHT_REPORT"
}

candidate_smoke_check_exo() {
  candidate_smoke_check "exo" "$EXO_BIN"
}

candidate_smoke_check_scheduler() {
  candidate_smoke_check "scheduler runner" "$SCHEDULER_BIN"
}

candidate_smoke_check() {
  local label="$1"
  local bin="$2"
  if [[ ! -x "$bin" ]]; then
    echo "error: $label binary missing or not executable: $bin" >&2
    return 1
  fi
  if ! "$bin" --help >/dev/null 2>&1; then
    echo "error: $label binary does not run ($bin --help exited nonzero)" >&2
    return 1
  fi
}

# Required checks are hardcoded below; the profile name only selects among
# them, so nothing from the environment is ever executed as shell input.
preflight_pnpm_lint() {
  (cd "$ROOT_DIR" && pnpm lint)
}

preflight_pnpm_typecheck() {
  (cd "$ROOT_DIR" && pnpm typecheck)
}

preflight_pnpm_test() {
  (cd "$ROOT_DIR" && pnpm test)
}

preflight_cargo_check_exo() {
  (cd "$ROOT_DIR" && cargo check -p exo --quiet)
}

preflight_cargo_check_workspace() {
  (cd "$ROOT_DIR" && cargo check --workspace --quiet)
}

preflight_harness_import_smoke() {
  # Exercises the TypeScript harness import graph and tool registration,
  # which a --help smoke on the Rust binary cannot reach.
  (
    cd "$ROOT_DIR" &&
      pnpm exec tsx examples/self-improving-agent/scripts/harness-import-smoke.mts
  )
}

request_repl_restart() {
  ensure_state_dir
  {
    printf 'requested_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'reason=guardian-build\n'
  } >"$(repl_restart_file)"
  echo "Requested control REPL child restart: $(repl_restart_file)"
}

DRAIN_CLAIM_SECONDS="${EXO_DRAIN_CLAIM_SECONDS:-15}"
DRAIN_GRACE_SECONDS="${EXO_DRAIN_GRACE_SECONDS:-300}"

scheduler_pid_file() {
  echo "$STATE_DIR/exo-scheduler.pid"
}

scheduler_restart_file() {
  echo "$STATE_DIR/exo-scheduler.restart"
}

scheduler_lock_file() {
  echo "$STATE_DIR/exo-scheduler.lock"
}

repl_restart_file() {
  echo "$STATE_DIR/exo-control.restart"
}

adapters_pid_file() {
  echo "$STATE_DIR/exo-adapters.pid"
}

scheduler_log_file() {
  echo "$STATE_DIR/exo-scheduler.log"
}

adapters_log_file() {
  echo "$STATE_DIR/exo-adapters.log"
}

kill_process_tree() {
  local signal="$1"
  local pid="$2"
  local child
  [[ "$pid" =~ ^[0-9]+$ ]] || return
  if command -v pgrep >/dev/null 2>&1; then
    while IFS= read -r child; do
      [[ -n "$child" ]] || continue
      kill_process_tree "$signal" "$child"
    done < <(pgrep -P "$pid" 2>/dev/null || true)
  fi
  kill "-$signal" "$pid" >/dev/null 2>&1 || true
}

terminate_process_tree() {
  local pid="$1"
  kill_process_tree TERM "$pid"
  sleep 1
  kill_process_tree KILL "$pid"
}

pid_running() {
  local pid_file="$1"
  local pid
  [[ -f "$pid_file" ]] || return 1
  pid="$(<"$pid_file")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  process_running "$pid"
}

process_running() {
  local pid="$1"
  local state
  kill -0 "$pid" >/dev/null 2>&1 || return 1
  state="$(ps -o stat= -p "$pid" 2>/dev/null)" || return 1
  [[ -n "$state" && "$state" != Z* ]]
}

exo_global_args() {
  printf '%s\0' --root "$EXO_ROOT"
  if [[ -f "$ENV_FILE" ]]; then
    printf '%s\0' --env-file "$ENV_FILE"
  fi
}

read_exo_global_args() {
  EXO_GLOBAL_ARGS=()
  while IFS= read -r -d '' arg; do
    EXO_GLOBAL_ARGS+=("$arg")
  done < <(exo_global_args)
}

ensure_exo_bin() {
  if [[ ! -x "$EXO_BIN" ]]; then
    die "exo binary is not executable: $EXO_BIN; run guardian build first"
  fi
}

ensure_scheduler_bin() {
  if [[ ! -x "$SCHEDULER_BIN" ]]; then
    die "scheduler runner is not executable: $SCHEDULER_BIN; run guardian build first"
  fi
}

start_scheduler() {
  ensure_state_dir
  ensure_scheduler_bin
  local pid_file log_file
  pid_file="$(scheduler_pid_file)"
  log_file="$(scheduler_log_file)"
  if pid_running "$pid_file"; then
    echo "Scheduler already running: $(<"$pid_file")"
    return
  fi
  rm -f "$(scheduler_lock_file)" "$(scheduler_restart_file)"
  echo "Starting scheduler..."
  local scheduler_args=(--root "$EXO_ROOT" --env-file-if-exists "$ENV_FILE")
  nohup "$SCHEDULER_BIN" "${scheduler_args[@]}" run --watch \
    --interval-seconds "$SCHEDULER_INTERVAL_SECONDS" >>"$log_file" 2>&1 &
  echo "$!" >"$pid_file"
  echo "Scheduler log: $log_file"
}

start_adapters() {
  ensure_state_dir
  ensure_exo_bin
  local pid_file log_file
  pid_file="$(adapters_pid_file)"
  log_file="$(adapters_log_file)"
  if pid_running "$pid_file"; then
    echo "Adapter runner already running: $(<"$pid_file")"
    return
  fi
  read_exo_global_args
  echo "Starting adapter runner..."
  nohup "$EXO_BIN" run --serve "${EXO_GLOBAL_ARGS[@]}" --harness "$HARNESS" \
      --adapters-only \
    >>"$log_file" 2>&1 &
  echo "$!" >"$pid_file"
  echo "Adapter log: $log_file"
}

stop_pid_file() {
  local label="$1"
  local pid_file="$2"
  local pid
  if [[ -f "$pid_file" ]]; then
    pid="$(<"$pid_file")"
    if [[ "$pid" =~ ^[0-9]+$ ]] && process_running "$pid"; then
      echo "Stopping $label..."
      terminate_process_tree "$pid"
    fi
  fi
  rm -f "$pid_file"
}

# Ask a runner to drain via its restart marker before falling back to a kill.
# The runner claims the request by deleting the marker, finishes in-flight
# work, and exits on its own. A runner that never claims the marker (an old
# build, or one wedged mid-task) gets the process tree treatment instead.
drain_pid_file() {
  local label="$1"
  local pid_file="$2"
  local marker="$3"
  local pid waited
  if [[ ! -f "$pid_file" ]]; then
    rm -f "$pid_file"
    return
  fi
  pid="$(<"$pid_file")"
  if ! [[ "$pid" =~ ^[0-9]+$ ]] || ! process_running "$pid"; then
    rm -f "$pid_file"
    return
  fi
  echo "Requesting graceful $label drain..."
  : >"$marker"
  waited=0
  while [[ -f "$marker" && "$waited" -lt "$DRAIN_CLAIM_SECONDS" ]]; do
    sleep 1
    waited=$((waited + 1))
  done
  if [[ -f "$marker" ]]; then
    rm -f "$marker"
    echo "$label did not claim the drain request; stopping process tree..."
    terminate_process_tree "$pid"
  else
    waited=0
    while process_running "$pid" && [[ "$waited" -lt "$DRAIN_GRACE_SECONDS" ]]; do
      sleep 1
      waited=$((waited + 1))
    done
    if process_running "$pid"; then
      echo "$label still running after ${DRAIN_GRACE_SECONDS}s drain grace; stopping process tree..."
      terminate_process_tree "$pid"
    else
      echo "$label drained and exited cleanly."
    fi
  fi
  rm -f "$pid_file"
}

stop_scheduler() {
  drain_pid_file "Exo scheduler" "$(scheduler_pid_file)" "$(scheduler_restart_file)"
  rm -f "$(scheduler_lock_file)"
}

stop_adapters() {
  local pid_file pid waited
  pid_file="$(adapters_pid_file)"
  if pid_running "$pid_file"; then
    pid="$(<"$pid_file")"
    echo "Requesting graceful Exo adapter runner shutdown..."
    kill -TERM "$pid"
    waited=0
    while process_running "$pid" && [[ "$waited" -lt "$DRAIN_GRACE_SECONDS" ]]; do
      sleep 1
      waited=$((waited + 1))
    done
    if process_running "$pid"; then
      echo "Adapter runner still running after ${DRAIN_GRACE_SECONDS}s; stopping process tree..."
      terminate_process_tree "$pid"
    fi
  fi
  rm -f "$pid_file"
}

start_services() {
  start_scheduler
  start_adapters
}

stop_services() {
  stop_scheduler
  stop_adapters
  echo "Stopped guardian-managed services. State in .exo was preserved."
}

restart_scheduler() {
  stop_scheduler
  start_scheduler
}

restart_adapters() {
  stop_adapters
  start_adapters
}

restart_services() {
  stop_services
  start_services
}

service_status() {
  local label="$1"
  local pid_file="$2"
  local log_file="$3"
  if pid_running "$pid_file"; then
    echo "$label: running pid $(<"$pid_file")"
  else
    echo "$label: stopped"
  fi
  echo "  pid: $pid_file"
  echo "  log: $log_file"
}

status() {
  echo "Service guardian config: $CONFIG_FILE"
  echo "exo: $EXO_BIN"
  echo "scheduler: $SCHEDULER_BIN"
  echo "env file: $ENV_FILE"
  service_status "scheduler" "$(scheduler_pid_file)" "$(scheduler_log_file)"
  service_status "adapters" "$(adapters_pid_file)" "$(adapters_log_file)"
  if [[ -f "$(repl_restart_file)" ]]; then
    echo "repl restart: pending ($(repl_restart_file))"
  else
    echo "repl restart: none pending"
  fi
}

show_logs() {
  local which="${1:-all}"
  case "$which" in
    scheduler)
      tail -n 80 "$(scheduler_log_file)" 2>/dev/null || true
      ;;
    adapters)
      tail -n 80 "$(adapters_log_file)" 2>/dev/null || true
      ;;
    all)
      echo "== scheduler =="
      tail -n 40 "$(scheduler_log_file)" 2>/dev/null || true
      echo "== adapters =="
      tail -n 40 "$(adapters_log_file)" 2>/dev/null || true
      ;;
    *)
      die "logs target must be scheduler or adapters"
      ;;
  esac
}

COMMAND="${1:-}"
if [[ -z "$COMMAND" || "$COMMAND" == "--help" || "$COMMAND" == "-h" ]]; then
  usage
  if [[ -z "$COMMAND" ]]; then
    exit 1
  fi
  exit 0
fi
shift

BUILD_BEFORE_RESTART=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --env-file)
      ENV_FILE="${2:-}"
      [[ -n "$ENV_FILE" ]] || die "--env-file requires a value"
      shift 2
      ;;
    --exo-bin)
      EXO_BIN="${2:-}"
      [[ -n "$EXO_BIN" ]] || die "--exo-bin requires a value"
      shift 2
      ;;
    --scheduler-bin)
      SCHEDULER_BIN="${2:-}"
      [[ -n "$SCHEDULER_BIN" ]] || die "--scheduler-bin requires a value"
      shift 2
      ;;
    --scheduler-interval)
      SCHEDULER_INTERVAL_SECONDS="${2:-}"
      [[ "$SCHEDULER_INTERVAL_SECONDS" =~ ^[0-9]+$ && "$SCHEDULER_INTERVAL_SECONDS" -gt 0 ]] || die "--scheduler-interval requires a positive integer"
      shift 2
      ;;
    --config)
      CONFIG_FILE="${2:-}"
      [[ -n "$CONFIG_FILE" ]] || die "--config requires a value"
      shift 2
      ;;
    --build)
      BUILD_BEFORE_RESTART=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      if [[ "$COMMAND" == "logs" && "${LOG_TARGET:-}" == "" ]]; then
        LOG_TARGET="$1"
        shift
      else
        die "unknown argument: $1"
      fi
      ;;
  esac
done

case "$COMMAND" in
  status)
    status
    ;;
  configure)
    write_config
    ;;
  build)
    build_all
    ;;
  start-services)
    start_services
    ;;
  stop-services)
    stop_services
    ;;
  restart-services)
    restart_services
    ;;
  restart-adapters)
    restart_adapters
    ;;
  restart-scheduler)
    restart_scheduler
    ;;
  restart-all)
    # Only the build path activates a new candidate, so only it runs the
    # fail-closed preflight. A plain restart re-launches the already-active
    # binaries; preflighting those would validate the running version, not a
    # candidate, and block recovery restarts on unrelated failures.
    if [[ "$BUILD_BEFORE_RESTART" == true ]]; then
      build_all
    fi
    restart_services
    ;;
  logs)
    show_logs "${LOG_TARGET:-all}"
    ;;
  *)
    die "unknown command: $COMMAND"
    ;;
esac
