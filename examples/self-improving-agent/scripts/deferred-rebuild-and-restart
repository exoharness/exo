#!/usr/bin/env bash
# Deferred rebuild_and_restart_exo runner.
#
# Sleeps briefly so the requesting turn can finish, runs the guardian
# build-and-restart pipeline, then finalizes the durable outcome file and
# appends a rebuild_and_restart_exo host event to the requesting conversation.
#
# Args:
#   $1 delay_seconds
#   $2 outcome_path
#   $3 update_id
#   $4 reason_json          JSON-encoded string|null
#   $5 exo_bin
#   $6 env_file
#   $7 exo_root
#   $@ guardian command...
set -u

delay="$1"
record="$2"
update_id="$3"
reason_json="$4"
exo_bin="$5"
env_file="$6"
exo_root="$7"
shift 7

printf '\n[%s] queued rebuild update %s reason=%s:' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  "$update_id" \
  "$reason_json"
for arg in "$@"; do
  printf ' %q' "$arg"
done
printf '\n'

sleep "$delay"
set +e
"$@"
code=$?
completed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ "$code" -eq 0 ]; then
  status=succeeded
elif [ "$code" -eq 3 ]; then
  # The guardian's activation preflight rejected the candidate (exit 3).
  # Distinct from a generic failure so the audit trail says *which* boundary
  # stopped the activation, not just that something exited nonzero.
  status=preflight_failed
else
  status=failed
fi

# Attach the guardian's structured per-check preflight report when present, so
# a rejected candidate is an inspectable iteration (which check, exit, duration).
# Best-effort and idempotent; `complete-rebuild-update` rewrites the record from
# a typed struct, so it is attached again after that call below.
attach_preflight_report() {
  preflight_report="$exo_root/activation-preflight.json"
  if [ -f "$preflight_report" ] && command -v node >/dev/null 2>&1; then
    node -e '
const fs = require("node:fs");
const [path, reportPath] = process.argv.slice(1);
try {
  const record = JSON.parse(fs.readFileSync(path, "utf8"));
  record.preflight = JSON.parse(fs.readFileSync(reportPath, "utf8"));
  fs.writeFileSync(path, `${JSON.stringify(record)}\n`);
} catch (error) {
  console.error(`failed to attach preflight report: ${error.message}`);
}
' "$record" "$preflight_report"
  fi
}
attach_preflight_report

if [ ! -x "$exo_bin" ]; then
  printf '[%s] rebuild update %s: exo binary missing at %s; writing outcome without event log\n' \
    "$completed_at" "$update_id" "$exo_bin"
  node -e '
const fs = require("node:fs");
const [path, status, exitCode, completedAt] = process.argv.slice(1);
const record = JSON.parse(fs.readFileSync(path, "utf8"));
record.status = status;
record.exitCode = Number(exitCode);
record.completedAt = completedAt;
fs.writeFileSync(path, `${JSON.stringify(record)}\n`);
' "$record" "$status" "$code" "$completed_at"
  exit "$code"
fi

set +e
exo_args=(--root "$exo_root")
if [[ -f "$env_file" ]]; then
  exo_args+=(--env-file "$env_file")
fi
"$exo_bin" thread "${exo_args[@]}" complete-rebuild-update \
  --outcome "$record" \
  --status "$status" \
  --exit-code "$code" \
  --completed-at "$completed_at"
record_code=$?
if [ "$record_code" -ne 0 ]; then
  printf '[%s] rebuild update %s: failed to record conversation event (exit %s); outcome file may be incomplete\n' \
    "$completed_at" "$update_id" "$record_code"
fi
attach_preflight_report
exit "$code"
