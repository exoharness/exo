{
  "name": "exo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e:agent-harnesses": "tsx exoharness/scripts/agent-harness-e2e.ts",
    "events:tail": "node examples/self-improving-agent/scripts/tail-agent-events.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "prepare": "node scripts/setup-hooks.mjs",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "docs:build": "vitepress build website/docs-src",
    "docs:dev": "vitepress dev website/docs-src",
    "website:build": "vite build --config website/vite.config.js && pnpm run docs:build",
    "website:dev": "node scripts/website-dev.mjs",
    "website:preview": "vite preview --config website/vite.config.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.126",
    "@anthropic-ai/sdk": "^0.106.0",
    "@braintrust/lingua": "^0.1.0",
    "@braintrust/lingua-types": "^0.1.1",
    "@braintrust/lingua-wasm": "^0.1.0",
    "@cursor/sdk": "^1.0.12",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mozilla/readability": "^0.6.0",
    "braintrust": "3.7.0",
    "linkedom": "^0.18.12",
    "openai": "6.33.0",
    "turndown": "^7.2.4",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/turndown": "^5.0.6",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "tsx": "4.21.0",
    "typescript": "^5.9.0",
    "vite": "8.0.3",
    "vitepress": "^1.6.4",
    "vitest": "4.1.2",
    "wrangler": "4.147.0"
  },
  "packageManager": "pnpm@10.26.2"
}
