{
  "name": "exo",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-24",
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    "run_worker_first": ["/chat", "/chat/*"],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RendezvousSession"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["RendezvousSession"],
    },
  ],
}
