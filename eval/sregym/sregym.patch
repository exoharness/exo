+
+
+def _reviewed_conductor(monkeypatch, cleanup_started: threading.Event) -> Conductor:
+    monkeypatch.setenv(conductor_module.REVIEW_TIMEOUT_ENV, "5")
+    conductor = _conductor(mitigation_evaluation=lambda _solution: {"success": False})
+    conductor.stage_sequence = conductor.stage_sequence[1:]
+    conductor.submission_stage = "mitigation"
+    conductor.problem = SimpleNamespace(
+        recover_fault=cleanup_started.set,
+        app=SimpleNamespace(cleanup=lambda: None),
+    )
+    return conductor
+
+
+async def _wait_for_stage(conductor: Conductor, stage: str) -> None:
+    for _ in range(200):
+        if conductor.submission_stage == stage:
+            return
+        await asyncio.sleep(0.01)
+    raise AssertionError(f"stage never became {stage!r}; is {conductor.submission_stage!r}")
+
+
+def test_graded_attempt_is_held_for_review_until_released(monkeypatch):
+    cleanup_started = threading.Event()
+    conductor = _reviewed_conductor(monkeypatch, cleanup_started)
+    monkeypatch.setattr(conductor_api, "_conductor", conductor)
+
+    async def run():
+        transport = httpx.ASGITransport(app=conductor_api.app)
+        async with httpx.AsyncClient(transport=transport, base_url="http://test") as client:
+            early = await client.get("/results")
+            assert early.status_code == 409
+
+            mitigation = await client.post("/submit", json={"stage": "mitigation", "solution": ""})
+            assert mitigation.status_code == 200
+            await _wait_for_stage(conductor, "review")
+            assert not cleanup_started.is_set()
+
+            results = await client.get("/results")
+            assert results.json()["Mitigation"] == {"success": False}
+            resubmission = await client.post("/submit", json={"stage": "mitigation", "solution": ""})
+            assert resubmission.status_code == 409
+
+            released = await client.post("/release")
+            assert released.json() == {"released": True}
+            await conductor.wait_for_submission_work(timeout=2)
+
+    asyncio.run(run())
+
+    assert cleanup_started.is_set()
+    assert conductor.submission_stage == "done"
+    assert conductor.results["Mitigation"] == {"success": False}
+
+
+def test_agent_exit_ends_review(monkeypatch):
+    cleanup_started = threading.Event()
+    conductor = _reviewed_conductor(monkeypatch, cleanup_started)
+
+    async def run():
+        await conductor.submit("", expected_stage="mitigation")
+        await _wait_for_stage(conductor, "review")
+        conductor.close_submissions()
+        await conductor.wait_for_submission_evaluations(timeout=1)
+        await conductor.wait_for_submission_work(timeout=2)
+
+    asyncio.run(run())
+
+    assert cleanup_started.is_set()
+    assert conductor.submission_stage == "done"
+
+
+def test_attempt_is_not_held_without_a_review_timeout(monkeypatch):
+    cleanup_started = threading.Event()
+    conductor = _reviewed_conductor(monkeypatch, cleanup_started)
+    monkeypatch.delenv(conductor_module.REVIEW_TIMEOUT_ENV)
+
+    async def run():
+        await conductor.submit("", expected_stage="mitigation")
+        await conductor.wait_for_submission_work(timeout=2)
+
+    asyncio.run(run())
+
+    assert cleanup_started.is_set()
+    assert conductor.submission_stage == "done"
