+        raise HTTPException(status_code=400, detail="No problem has been started")
+    stage, _, _ = conductor.submission_state()
+    if stage != "review":
+        raise HTTPException(status_code=409, detail=f"No attempt is held for review; current stage is {stage!r}")
+    return conductor
